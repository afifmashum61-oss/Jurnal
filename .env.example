# Contoh Variabel Lingkungan Firebase untuk Vercel / Lokal
# Salin berkas ini menjadi .env.local untuk pengujian lokal,
# atau masukkan variabel ini di menu Settings -> Environment Variables di Vercel Dashboard.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=jurnal-guru-darussalam.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jurnal-guru-darussalam
VITE_FIREBASE_STORAGE_BUCKET=jurnal-guru-darussalam.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def
